@page

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>VIMO CHAT- Random Video Chat</title>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                font-family: Arial, Helvetica, sans-serif;
                background: radial-gradient(circle at top left, #4c1d95, transparent 35%), radial-gradient(circle at bottom right, #0e7490, transparent 35%), #080b16;
                color: white;
                overflow-x: hidden;
            }

            .app {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* ================= HEADER ================= */

            header {
                height: 75px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 35px;
                border-bottom: 1px solid rgba(255,255,255,.08);
                background: rgba(5,8,20,.55);
                backdrop-filter: blur(18px);
            }

            .logo {
                font-size: 30px;
                font-weight: 900;
                letter-spacing: 3px;
                background: linear-gradient(90deg,#8b5cf6,#22d3ee);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .online {
                padding: 9px 15px;
                border-radius: 50px;
                background: rgba(34,197,94,.12);
                border: 1px solid rgba(34,197,94,.3);
                color: #4ade80;
                font-size: 13px;
            }

            /* ================= MAIN ================= */

            .container {
                width: min(1200px, 94%);
                margin: auto;
                padding: 25px 0 15px;
            }

            .videos {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .video-card {
                position: relative;
                height: 430px;
                border-radius: 24px;
                overflow: hidden;
                background: #101522;
                border: 1px solid rgba(255,255,255,.09);
                box-shadow: 0 20px 60px rgba(0,0,0,.35);
            }

            video {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                background: radial-gradient(circle,#20283b,#090c14);
            }

            .video-label {
                position: absolute;
                left: 16px;
                top: 16px;
                padding: 8px 13px;
                border-radius: 10px;
                background: rgba(0,0,0,.55);
                backdrop-filter: blur(10px);
                font-size: 13px;
                z-index: 2;
            }

            .stranger-placeholder {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 12px;
                color: #94a3b8;
                background: radial-gradient(circle at center, #172033, #090c14);
                z-index: 1;
            }

            .stranger-icon {
                width: 75px;
                height: 75px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 32px;
                background: rgba(139,92,246,.15);
                border: 1px solid rgba(139,92,246,.3);
            }

            /* ================= STATUS ================= */

            .status-area {
                display: flex;
                justify-content: center;
                margin: 22px 0;
            }

            .status {
                padding: 10px 18px;
                border-radius: 50px;
                background: rgba(255,255,255,.07);
                border: 1px solid rgba(255,255,255,.1);
                color: #cbd5e1;
                font-size: 14px;
            }

            /* ================= CONTROLS ================= */

            .controls {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            button {
                border: none;
                cursor: pointer;
                color: white;
                font-weight: 700;
                font-size: 14px;
                transition: .2s ease;
            }

                button:hover {
                    transform: translateY(-2px);
                }

                button:active {
                    transform: scale(.96);
                }

            .main-btn {
                min-width: 145px;
                height: 48px;
                border-radius: 14px;
                padding: 0 22px;
            }

            .start {
                background: linear-gradient(135deg,#8b5cf6,#6366f1);
                box-shadow: 0 10px 30px rgba(99,102,241,.25);
            }

            .next {
                background: linear-gradient(135deg,#06b6d4,#0ea5e9);
                box-shadow: 0 10px 30px rgba(14,165,233,.2);
            }

            .stop {
                background: #252b3a;
            }

            .control-btn {
                min-width: 125px;
                height: 44px;
                border-radius: 12px;
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.1);
            }

                .control-btn.off {
                    background: rgba(239,68,68,.18);
                    border-color: rgba(239,68,68,.35);
                    color: #fca5a5;
                }

            /* ================= FOOTER ================= */

            footer {
                text-align: center;
                padding: 20px;
                color: #64748b;
                font-size: 12px;
            }

                footer span {
                    color: #a78bfa;
                    font-weight: 700;
                }

            /* ================= MOBILE ================= */

            @@media (max-width: 800px) {

                header {
                    padding: 0 18px;
                    height: 65px;
                }

                .logo {
                    font-size: 25px;
                }

                .videos {
                    grid-template-columns: 1fr;
                }

                .video-card {
                    height: 300px;
                }

                .videos .video-card:first-child {
                    height: 250px;
                }

                .container {
                    padding-top: 15px;
                }

                .controls {
                    gap: 8px;
                }

                .main-btn,
                .control-btn {
                    min-width: 115px;
                }
            }
    </style>
</head>

<body>

    <div class="app">

        <!-- HEADER -->
        <header>
            <div class="logo">VIMO CHAT</div>

            <div class="online-badge">
                <span class="online-dot">●</span>
                <span id="onlineCount">0</span> Online
                        </div>
        </header>


        <!-- MAIN -->
        <main class="container">

            <div class="videos">

                <!-- YOUR CAMERA -->
                <div class="video-card">

                    <div class="video-label">
                        📷 You
                    </div>

                    <video id="localVideo"
                           autoplay
                           playsinline
                           muted>
                    </video>

                </div>


                <!-- STRANGER -->
                <div class="video-card">

                    <div class="video-label">
                        👤 Stranger
                    </div>

                    <div id="strangerPlaceholder"
                         class="stranger-placeholder">

                        <div class="stranger-icon">
                            👤
                        </div>

                        <div>
                            Waiting for stranger...
                        </div>

                    </div>

                    <video id="remoteVideo"
                           autoplay
                           playsinline>
                    </video>

                </div>

            </div>


            <!-- STATUS -->

            <div class="status-area">

                <div id="status"
                     class="status">

                    ● Ready to connect

                </div>

            </div>


            <!-- BUTTONS -->

            <div class="controls">

                <button id="startBtn"
                        class="main-btn start"
                        onclick="startChat()">

                    ▶ Start Chat

                </button>


                <button id="nextBtn"
                        class="main-btn next"
                        onclick="nextStranger()">

                    ⟳ NEXT

                </button>


                <button id="stopBtn"
                        class="main-btn stop"
                        onclick="stopChat()">

                    ■ Stop

                </button>

            </div>


            <!-- CAMERA + MIC -->

            <div class="controls"
                 style="margin-top:12px;">

                <button id="cameraBtn"
                        class="control-btn"
                        onclick="toggleCamera()">

                    📷 Camera ON

                </button>


                <button id="micBtn"
                        class="control-btn"
                        onclick="toggleMic()">

                    🎙 Mic ON

                </button>

            </div>

        </main>


        <!-- FOOTER -->

        <footer>

            VIMO Video and audio Chat
            <br>

            Developed by <span>ADIB</span>

        </footer>

    </div>


    <script>

            // ==========================================
            // VARIABLES
            // ==========================================

            let connection = null;

            let localStream = null;

            let peerConnection = null;

            let strangerId = null;

            let started = false;

            let pendingIceCandidates = [];

            let cameraEnabled = true;

            let micEnabled = true;


            // ==========================================
            // HTML ELEMENTS
            // ==========================================

            const localVideo =
                document.getElementById("localVideo");

            const remoteVideo =
                document.getElementById("remoteVideo");

            const strangerPlaceholder =
                document.getElementById("strangerPlaceholder");

            const status =
                document.getElementById("status");

            const startBtn =
                document.getElementById("startBtn");

            const nextBtn =
                document.getElementById("nextBtn");

            const stopBtn =
                document.getElementById("stopBtn");

            const cameraBtn =
                document.getElementById("cameraBtn");

            const micBtn =
                document.getElementById("micBtn");


            // ==========================================
            // WEBRTC CONFIG
            // ==========================================

            const rtcConfig = {

                iceServers: [

                    {
                        urls:
                            "stun:stun.l.google.com:19302"
                    },

                    {
                        urls:
                            "stun:stun1.l.google.com:19302"
                    }

                ]

            };


            // ==========================================
            // STATUS
            // ==========================================

            function setStatus(text) {

                status.innerText = text;

            }


            // ==========================================
            // SIGNALR
            // ==========================================

            async function connectSignalR() {

                if (connection &&
                    connection.state ===
                    signalR.HubConnectionState.Connected) {

                    return;

                }


                connection =
                    new signalR.HubConnectionBuilder()

                        .withUrl("/chathub")

                        .withAutomaticReconnect()

                        .build();


                // ======================================
                // WAITING
                // ======================================
                            connection.on(
                "OnlineUsersChanged",
                function (count) {

                    document.getElementById(
                        "onlineCount"
                    ).innerText = count.toLocaleString();

                }
            );

                connection.on(
                    "WaitingForStranger",
                    function () {

                        setStatus(
                            "● Waiting for stranger..."
                        );

                    }
                );


                // ======================================
                // STRANGER FOUND
                // ======================================

                connection.on(
                    "StrangerFound",
                    async function (userId) {

                        strangerId = userId;

                        setStatus(
                            "● Stranger found! Connecting..."
                        );


                        await createPeerConnection();


                        // First user creates offer
                        if (connection.connectionId < strangerId) {

                            const offer =
                                await peerConnection.createOffer();

                            await peerConnection.setLocalDescription(
                                offer
                            );


                            await connection.invoke(
                                "SendOffer",
                                strangerId,
                                JSON.stringify(
                                    peerConnection.localDescription
                                )
                            );

                        }

                    }
                );


                // ======================================
                // RECEIVE OFFER
                // ======================================

                connection.on(
                    "ReceiveOffer",
                    async function (
                        fromUserId,
                        offerString
                    ) {

                        strangerId = fromUserId;

                        await createPeerConnection();


                        const offer =
                            JSON.parse(offerString);


                        await peerConnection.setRemoteDescription(
                            new RTCSessionDescription(offer)
                        );


                        await processPendingIceCandidates();


                        const answer =
                            await peerConnection.createAnswer();


                        await peerConnection.setLocalDescription(
                            answer
                        );


                        await connection.invoke(
                            "SendAnswer",
                            strangerId,
                            JSON.stringify(
                                peerConnection.localDescription
                            )
                        );

                    }
                );


                // ======================================
                // RECEIVE ANSWER
                // ======================================

                connection.on(
                    "ReceiveAnswer",
                    async function (
                        fromUserId,
                        answerString
                    ) {

                        strangerId = fromUserId;


                        const answer =
                            JSON.parse(answerString);


                        await peerConnection.setRemoteDescription(
                            new RTCSessionDescription(answer)
                        );


                        await processPendingIceCandidates();

                    }
                );


                // ======================================
                // RECEIVE ICE
                // ======================================

                connection.on(
                    "ReceiveIceCandidate",
                    async function (
                        fromUserId,
                        candidateString
                    ) {

                        strangerId = fromUserId;


                        const candidate =
                            JSON.parse(candidateString);


                        if (
                            peerConnection &&
                            peerConnection.remoteDescription
                        ) {

                            try {

                                await peerConnection.addIceCandidate(
                                    new RTCIceCandidate(candidate)
                                );

                            }
                            catch (error) {

                                console.error(
                                    "ICE error:",
                                    error
                                );

                            }

                        }
                        else {

                            pendingIceCandidates.push(
                                candidate
                            );

                        }

                    }
                );


                // ======================================
                // CONNECT
                // ======================================

                await connection.start();


                console.log(
                    "SignalR connected:",
                    connection.connectionId
                );

            }


            // ==========================================
            // CREATE PEER CONNECTION
            // ==========================================

            async function createPeerConnection() {

                if (peerConnection) {

                    peerConnection.close();

                }


                pendingIceCandidates = [];


                peerConnection =
                    new RTCPeerConnection(
                        rtcConfig
                    );


                // ======================================
                // ADD CAMERA + MIC
                // ======================================

                if (localStream) {

                    localStream
                        .getTracks()
                        .forEach(
                            track => {

                                peerConnection.addTrack(
                                    track,
                                    localStream
                                );

                            }
                        );

                }


                // ======================================
                // REMOTE VIDEO
                // ======================================

                peerConnection.ontrack =
                    async function (event) {

                        console.log(
                            "Remote track received"
                        );


                        if (event.streams &&
                            event.streams.length > 0) {

                            remoteVideo.srcObject =
                                event.streams[0];

                        }


                        strangerPlaceholder.style.display =
                            "none";


                        remoteVideo.style.display =
                            "block";


                        remoteVideo.muted =
                            false;


                        remoteVideo.volume =
                            1.0;


                        try {

                            await remoteVideo.play();

                        }
                        catch (error) {

                            console.log(
                                "Autoplay blocked:",
                                error
                            );

                        }


                        setStatus(
                            "● Live video + audio connected"
                        );

                    };


                // ======================================
                // ICE CANDIDATE
                // ======================================

                peerConnection.onicecandidate =
                    async function (event) {

                        if (
                            event.candidate &&
                            strangerId &&
                            connection
                        ) {

                            await connection.invoke(
                                "SendIceCandidate",
                                strangerId,
                                JSON.stringify(
                                    event.candidate
                                )
                            );

                        }

                    };


                // ======================================
                // CONNECTION STATE
                // ======================================

                peerConnection.onconnectionstatechange =
                    function () {

                        console.log(
                            "Connection:",
                            peerConnection.connectionState
                        );


                        if (
                            peerConnection.connectionState ===
                            "connected"
                        ) {

                            setStatus(
                                "● Live video + audio connected"
                            );

                        }


                        if (
                            peerConnection.connectionState ===
                            "failed"
                        ) {

                            setStatus(
                                "● Connection failed"
                            );

                        }


                        if (
                            peerConnection.connectionState ===
                            "disconnected"
                        ) {

                            setStatus(
                                "● Stranger disconnected"
                            );

                        }

                    };


                // ======================================
                // ICE STATE
                // ======================================

                peerConnection.oniceconnectionstatechange =
                    function () {

                        console.log(
                            "ICE:",
                            peerConnection.iceConnectionState
                        );

                    };

            }


            // ==========================================
            // PROCESS PENDING ICE
            // ==========================================

            async function processPendingIceCandidates() {

                if (!peerConnection) {

                    return;

                }


                for (
                    const candidate
                    of pendingIceCandidates
                ) {

                    try {

                        await peerConnection.addIceCandidate(
                            new RTCIceCandidate(candidate)
                        );

                    }
                    catch (error) {

                        console.error(
                            "Pending ICE error:",
                            error
                        );

                    }

                }


                pendingIceCandidates = [];

            }


            // ==========================================
            // START CHAT
            // ==========================================

            async function startChat() {

                if (started) {

                    return;

                }


                try {

                    setStatus(
                        "● Starting camera..."
                    );


                    // Connect server
                    await connectSignalR();


                    // Camera + microphone
                    localStream =
                        await navigator.mediaDevices
                            .getUserMedia({

                                video: true,

                                audio: true

                            });


                    localVideo.srcObject =
                        localStream;


                    cameraEnabled = true;

                    micEnabled = true;


                    updateCameraButton();

                    updateMicButton();


                    started = true;


                    setStatus(
                        "● Camera ON • Connected to server"
                    );


                    await connection.invoke(
                        "JoinChat"
                    );


                    startBtn.disabled = true;


                }
                catch (error) {

                    console.error(error);


                    setStatus(
                        "● Camera/microphone permission failed"
                    );

                    alert(
                        "Camera and Microphone permission Allow "
                    );

                }

            }


            // ==========================================
            // NEXT STRANGER
            // ==========================================

            async function nextStranger() {

                if (!started) {

                    await startChat();

                    return;

                }


                setStatus(
                    "● Finding next stranger..."
                );


                // Close old connection
                if (peerConnection) {

                    peerConnection.close();

                    peerConnection = null;

                }


                strangerId = null;

                pendingIceCandidates = [];


                // Clear stranger video
                remoteVideo.srcObject = null;

                remoteVideo.style.display =
                    "none";

                strangerPlaceholder.style.display =
                    "flex";


                // Join matchmaking again
                try {

                    await connection.invoke(
                        "JoinChat"
                    );

                }
                catch (error) {

                    console.error(error);

                    setStatus(
                        "● Could not find next stranger"
                    );

                }

            }


            // ==========================================
            // CAMERA ON / OFF
            // ==========================================

            function toggleCamera() {

                if (!localStream) {

                    return;

                }


                const videoTracks =
                    localStream.getVideoTracks();


                if (videoTracks.length === 0) {

                    return;

                }


                cameraEnabled =
                    !cameraEnabled;


                videoTracks.forEach(
                    track => {

                        track.enabled =
                            cameraEnabled;

                    }
                );


                updateCameraButton();

            }


            // ==========================================
            // CAMERA BUTTON
            // ==========================================

            function updateCameraButton() {

                if (cameraEnabled) {

                    cameraBtn.innerText =
                        "📷 Camera ON";

                    cameraBtn.classList.remove(
                        "off"
                    );

                }
                else {

                    cameraBtn.innerText =
                        "📷 Camera OFF";

                    cameraBtn.classList.add(
                        "off"
                    );

                }

            }


            // ==========================================
            // MIC ON / OFF
            // ==========================================

            function toggleMic() {

                if (!localStream) {

                    return;

                }


                const audioTracks =
                    localStream.getAudioTracks();


                if (audioTracks.length === 0) {

                    return;

                }


                micEnabled =
                    !micEnabled;


                audioTracks.forEach(
                    track => {

                        track.enabled =
                            micEnabled;

                    }
                );


                updateMicButton();

            }


            // ==========================================
            // MIC BUTTON
            // ==========================================

            function updateMicButton() {

                if (micEnabled) {

                    micBtn.innerText =
                        "🎙 Mic ON";

                    micBtn.classList.remove(
                        "off"
                    );

                }
                else {

                    micBtn.innerText =
                        "🎙 Mic OFF";

                    micBtn.classList.add(
                        "off"
                    );

                }

            }


            // ==========================================
            // STOP CHAT
            // ==========================================

            async function stopChat() {

                started = false;

                strangerId = null;

                pendingIceCandidates = [];


                // Close WebRTC
                if (peerConnection) {

                    peerConnection.close();

                    peerConnection = null;

                }


                // Stop camera + mic
                if (localStream) {

                    localStream
                        .getTracks()
                        .forEach(
                            track =>
                                track.stop()
                        );

                    localStream = null;

                }


                // Clear videos
                localVideo.srcObject = null;

                remoteVideo.srcObject = null;


                remoteVideo.style.display =
                    "none";

                strangerPlaceholder.style.display =
                    "flex";


                cameraEnabled = true;

                micEnabled = true;


                updateCameraButton();

                updateMicButton();


                startBtn.disabled = false;


                setStatus(
                    "● Chat stopped"
                );

            }

    </script>

</body>
</html>